server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
    }
    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=86400" always;

    root /opt/ruanchuang/web/current;
    index index.html;

    # Entry points must be reloaded from the current release. Content-addressed
    # router names in index.html prevent an old HTTP cache from winning.
    location = /index.html {
        # A local add_header overrides inherited headers on older Nginx.
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location = /release.json {
        # A local add_header overrides inherited headers on older Nginx.
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location = /flutter_service_worker.js {
        # A local add_header overrides inherited headers on older Nginx.
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /stitch/ {
        # A local add_header overrides inherited headers on older Nginx.
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location ~ ^/(openapi\.json|docs|redoc)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(auth|schedule|events|microtasks|emotion|energy|goals|team|review|settings|diagnostics|version|server|sync)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        # A local add_header overrides inherited headers on older Nginx.
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ /index.html;
    }
}
