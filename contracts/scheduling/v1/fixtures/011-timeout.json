{
  "schemaVersion": "scheduling/v1",
  "id": "timeout-001",
  "kind": "boundary",
  "tags": ["timeout"],
  "request": {
    "operation": "apply",
    "timeoutMs": 25,
    "simulateDelayMs": 100,
    "beforeEntryIds": ["focus"],
    "afterEntryIds": ["focus", "urgent"]
  },
  "assertions": {
    "finalState": {
      "status": "timeout",
      "timeout": true,
      "originalPlanPreserved": true,
      "partialWrites": false,
      "errorCode": "timeout"
    }
  },
  "review": {
    "classification": "allowed_difference",
    "reason": "两端均确定性报告 timeout、无部分写入并保留原计划；entryIds 等额外诊断字段不属于断言差异。"
  }
}
