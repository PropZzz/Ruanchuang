{
  "schemaVersion": "scheduling/v1",
  "id": "timeout-001",
  "kind": "boundary",
  "tags": ["timeout"],
  "request": {
    "operation": "apply",
    "timeoutMs": 25,
    "simulateDelayMs": 100,
    "beforeEntryIds": ["focus"],
